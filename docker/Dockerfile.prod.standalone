FROM node:24.22.1-slim AS base

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable

FROM base AS deps

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

FROM base AS builder

ARG DATABASE_URL=file:/tmp/xc2f-build.db
ARG NEXT_PUBLIC_SERVER_URL=http://localhost:3000
ARG NEXT_PUBLIC_SITE_NAME=XC2F
ARG S3_ENDPOINT=http://localhost:3000

ENV BUILD_OUTPUT=standalone
ENV DATABASE_URL=$DATABASE_URL
ENV NEXT_PUBLIC_SERVER_URL=$NEXT_PUBLIC_SERVER_URL
ENV NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME
ENV S3_ENDPOINT=$S3_ENDPOINT

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN PAYLOAD_SECRET=build-secret \
    CRON_SECRET=build-secret \
    PREVIEW_SECRET=build-secret \
    AWS_SERVICE_REGION=us-east-1 \
    S3_ACCESS_KEY_ID=build-access-key \
    S3_SECRET=build-secret-key \
    S3_BUCKET=build-bucket \
    EMAIL_DEFAULT_FROM_NAME=XC2F \
    EMAIL_DEFAULT_FROM_NO_REPLY=no-reply@example.com \
    EMAIL_DEFAULT_FROM=no-reply@example.com \
    EMAIL_DEFAULT_REPLY=no-reply@example.com \
    pnpm build

FROM node:24.22.1-slim AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y sqlite3 ca-certificates fontconfig --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

COPY ["src/app/(frontend)/fonts/PressStart2P-Regular.ttf", "/usr/share/fonts/truetype/"]
RUN fc-cache -f

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/scripts/check-sqlite-runtime.cjs ./scripts/check-sqlite-runtime.cjs

RUN mkdir -p /app/data && chown nextjs:nodejs /app/data

USER nextjs

# Fail the build if either client entry or its JS/native dependencies are incomplete.
RUN node scripts/check-sqlite-runtime.cjs

EXPOSE 3000

CMD ["node", "server.js"]
